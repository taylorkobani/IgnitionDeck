<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
	<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	<UseWinUI>true</UseWinUI>
	<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
	<StartupObject>IgnitionDeck.Program</StartupObject>
	<WindowsPackageType>None</WindowsPackageType>
	<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
	<Platforms>x64</Platforms>
	<PlatformTarget>x64</PlatformTarget>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
	<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250909003" />
	<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>
  <ItemGroup>
	<ProjectReference Include="..\IgnitionDeck.Core\IgnitionDeck.Core.csproj" />
  </ItemGroup>
  <!-- SDK folder publishing must include the generated WinUI application resources. -->
  <Target Name="IncludeApplicationPriInPublish" AfterTargets="ComputeFilesToPublish">
	<Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The generated WinUI application PRI is missing. Build and publish using Visual Studio MSBuild with WinUI tooling." />
	<ItemGroup>
	  <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
		<RelativePath>$(AssemblyName).pri</RelativePath>
		<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </ResolvedFileToPublish>
	</ItemGroup>
  </Target>
</Project>
